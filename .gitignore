# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/

# Environment — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Terraform state and credentials
.terraform/
*.tfstate
*.tfstate.backup
terraform.tfvars
# .terraform.lock.hcl is intentionally tracked for reproducible provider versions
# *.tfvars.example files are intentionally tracked (no secrets)

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Lock files are platform-specific (Windows vs Linux @emnapi/sharp binaries differ).
# Generated by CI on Linux — do not commit Windows-generated versions.
frontend/package-lock.json
frontend-demo/package-lock.json

# Lambda build artifacts
dist/
*.zip

# Security — private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test coverage
.coverage
htmlcov/
.pytest_cache/
