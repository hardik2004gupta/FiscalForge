# FiscalForge Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# See CLAUDE.md §19 Security Contract.

# ─── AWS Configuration ───────────────────────────────────────────────────────
# AWS region for all API calls. Lambda uses this for boto3 clients.
AWS_REGION=us-east-1

# ─── Development Mode ────────────────────────────────────────────────────────
# Set to "true" to use mock AWS data instead of real AWS APIs.
# Always "true" in tests. Never "true" in production.
FISCALFORGE_MOCK_AWS=true

# ─── AI Advisor ──────────────────────────────────────────────────────────────
# OpenAI API key for LangGraph agent. Required when FISCALFORGE_MOCK_AWS=false.
OPENAI_API_KEY=

# OpenAI model to use. Defaults to gpt-4o.
OPENAI_MODEL=gpt-4o

# ─── Frontend ────────────────────────────────────────────────────────────────
# API Gateway base URL. Set to your Terraform output after deployment.
# For local Lambda development, use a local server URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
